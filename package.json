{
  "name": "webflow-library",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Attributgesteuerte Verhaltens-Utilities für veröffentlichte Webflow-Seiten",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "skill": "node scripts/skill.mjs",
    "skill:link": "node scripts/skill-link.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && node scripts/skill.mjs --check",
    "preversion": "pnpm check",
    "version": "node scripts/changelog.mjs && pnpm build && node scripts/skill.mjs && git add dist skill",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
